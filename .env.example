# HeatSafe AI — Environment Configuration
# Copy this file to .env and adjust variables for your deployment

# Application
PROJECT_NAME="HeatSafe AI"
VERSION="1.0.0"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Security & Authentication
# Generate a secure key in production using: openssl rand -hex 32
SECRET_KEY="heatsafe_super_secret_jwt_key_2026_tamil_nadu_outdoor_worker_safety"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Local SQLite fallback: sqlite:///./heatsafe.db
# Production PostgreSQL example: postgresql://postgres:password@localhost:5432/heatsafe_db
DATABASE_URL="sqlite:///./heatsafe.db"

# External APIs
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"

# Optional Cloud Providers (if SMS/WhatsApp alerting or Managed Identity is enabled)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_PHONE=""
# OIDC_ISSUER_URL=""
# OIDC_CLIENT_ID=""
